{
  "id": "rss-reader",
  "name": "RSS 订阅",
  "version": "0.1.0",
  "publisher": "g-group",
  "description": "示例数据源插件:按订阅地址拉取 RSS/Atom 条目,宿主盖章为不可信外部事件。在宿主起的隔离进程里运行(只读本包目录、不能写文件或起子进程);网络未隔离,按 net:fetch 权限声明。",
  "kinds": [
    "data-source"
  ],
  "permissions": [
    {
      "key": "net:fetch",
      "description": "访问你配置的订阅地址"
    }
  ],
  "commands": [
    {
      "name": "rss",
      "description": "看某个订阅的最新条目",
      "args": [
        {
          "name": "feed",
          "description": "订阅名",
          "kind": "text",
          "required": false
        }
      ]
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "feeds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "entry": "index.mjs"
}
