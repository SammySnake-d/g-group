{
  "name": "g-group",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check:docs": "node scripts/check-docs.ts",
    "check:contracts": "node scripts/check-contracts.ts",
    "check:structure": "node scripts/check-structure.ts",
    "check": "npm run check:docs && npm run check:contracts && npm run check:structure && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings",
    "test": "node scripts/gates/test-runner.ts \"packages/**/*.test.ts\" \"scripts/gates/*.test.ts\"",
    "gates": "node scripts/gates/run-all.ts",
    "gates:selftest": "node scripts/gates/run-all.ts --self-test",
    "gates:mutation": "node scripts/gates/mutation.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
