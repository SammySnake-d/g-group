{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@g-group/ui-core": [
        "../../packages/ui-core/src/index.ts"
      ],
      "@g-group/api-contract": [
        "../../packages/api-contract/src/index.ts"
      ]
    }
  },
  "include": [
    "electron/**/*.ts",
    "vite.electron.config.ts"
  ]
}
