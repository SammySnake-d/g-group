{
  "name": "@g-group/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "g-group 桌面端:Electron 壳 + React 渲染层",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "vite build -c vite.electron.config.ts && GG_ENTRY=preload vite build -c vite.electron.config.ts && GG_ENTRY=report-mcp vite build -c vite.electron.config.ts",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.electron.json --noEmit",
    "test:e2e": "node verify/serial.mjs npx playwright test",
    "shots": "node -e \"process.env.GG_SHOTS||(console.error('先设 GG_SHOTS=截图输出目录'),process.exit(1))\" && node verify/serial.mjs npx playwright test --project=renderer",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "verify:structure": "node verify/structure.mjs",
    "e2e": "node verify/serial.mjs npx playwright test --project=renderer",
    "e2e:electron": "node verify/serial.mjs npx playwright test --project=electron",
    "verify:mutate": "node verify/serial.mjs node verify/mutate.mjs",
    "pack:mac": "node scripts/pack-mac.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
