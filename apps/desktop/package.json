{
  "name": "@g-group/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "g-group 桌面端:Electron 壳 + React 渲染层",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "vite build -c vite.electron.config.ts && GG_ENTRY=preload vite build -c vite.electron.config.ts",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.electron.json --noEmit",
    "test:e2e": "playwright test",
    "shots": "node -e \"process.env.GG_SHOTS||(console.error('先设 GG_SHOTS=截图输出目录'),process.exit(1))\" && playwright test --project=renderer",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "verify:structure": "node verify/structure.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.10.1",
    "open-bot-avatar": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "^39.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
